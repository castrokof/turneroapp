<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e3c72">

    <!-- WebView para mostrar la pantalla de turnos -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pantalla de configuracion -->
    <LinearLayout
        android:id="@+id/configLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        android:background="#1e3c72">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sistema de Turnos"
            android:textSize="36sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pantalla TV"
            android:textSize="24sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingrese la IP del servidor:"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:hint="Ej: 192.168.1.100"
            android:textSize="24sp"
            android:textColor="#333333"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:inputType="textUri"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:text="Conectar"
            android:textSize="20sp"
            android:padding="16dp"
            android:background="#28a745"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presione BACK para cambiar configuracion"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</FrameLayout>
